# Porta do servidor
PORT=3000

# Onde o banco JSON é gravado
COUPON_DB_PATH=./data/db.json

# Feed oficial de cupons (opcional) — sem isto, só cupons de demo e da comunidade
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# Links de saída por loja (opcional). Formatos: awin:<id>, tag:<codigo>, deeplink:<url com {url}>
AFFILIATE_PICHAU=
AFFILIATE_AMAZON_BR=
